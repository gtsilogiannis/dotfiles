{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "gtsilos",
  "author": "Giannis Tsilogiannis",
  "themes": [
    {
      "name": "gtsilos",
      "appearance": "{{mode}}",
      "style": {
        "background.appearance": "opaque",

        "background": "{{colors.surface_container.default.hex}}",
        "surface.background": "{{colors.surface_container_low.default.hex}}",
        "elevated_surface.background": "{{colors.surface_container_high.default.hex}}",
        "panel.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.background": "{{colors.surface_container_low.default.hex}}",
        "title_bar.inactive_background": "{{colors.surface_container_lowest.default.hex}}",
        "status_bar.background": "{{colors.surface_container_low.default.hex}}",
        "toolbar.background": "{{colors.surface.default.hex}}",
        "tab_bar.background": "{{colors.surface_container_low.default.hex}}",
        "tab.inactive_background": "{{colors.surface_container_low.default.hex}}",
        "tab.active_background": "{{colors.surface.default.hex}}",
        "drop_target.background": "#{{colors.primary.default.hex_stripped}}33",

        "border": "{{colors.outline_variant.default.hex}}",
        "border.variant": "{{colors.surface_container_high.default.hex}}",
        "border.focused": "{{colors.primary.default.hex}}",
        "border.selected": "{{colors.primary.default.hex}}",
        "border.transparent": "#00000000",
        "border.disabled": "{{colors.outline_variant.default.hex}}",
        "pane.focused_border": "{{colors.primary.default.hex}}",
        "pane_group.border": "{{colors.outline_variant.default.hex}}",
        "panel.focused_border": "{{colors.primary.default.hex}}",
        "panel.indent_guide": "{{colors.outline_variant.default.hex}}",
        "panel.indent_guide_active": "{{colors.outline.default.hex}}",
        "panel.indent_guide_hover": "{{colors.outline.default.hex}}",

        "element.background": "{{colors.surface_container_high.default.hex}}",
        "element.hover": "{{colors.surface_container_highest.default.hex}}",
        "element.active": "{{colors.surface_variant.default.hex}}",
        "element.selected": "{{colors.secondary_container.default.hex}}",
        "element.disabled": "{{colors.surface_container.default.hex}}",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{colors.surface_container_high.default.hex}}",
        "ghost_element.active": "{{colors.surface_container_highest.default.hex}}",
        "ghost_element.selected": "{{colors.secondary_container.default.hex}}",
        "ghost_element.disabled": "#00000000",

        "text": "{{colors.on_surface.default.hex}}",
        "text.muted": "{{colors.on_surface_variant.default.hex}}",
        "text.placeholder": "{{colors.outline.default.hex}}",
        "text.disabled": "{{colors.outline.default.hex}}",
        "text.accent": "{{colors.primary.default.hex}}",
        "icon": "{{colors.on_surface.default.hex}}",
        "icon.muted": "{{colors.on_surface_variant.default.hex}}",
        "icon.placeholder": "{{colors.outline.default.hex}}",
        "icon.disabled": "{{colors.outline.default.hex}}",
        "icon.accent": "{{colors.primary.default.hex}}",
        "link_text.hover": "{{colors.primary.default.hex}}",

        "scrollbar.thumb.background": "#{{colors.on_surface_variant.default.hex_stripped}}4d",
        "scrollbar.thumb.hover_background": "#{{colors.on_surface_variant.default.hex_stripped}}80",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",
        "search.match_background": "#{{colors.tertiary.default.hex_stripped}}4d",

        "editor.background": "{{colors.surface.default.hex}}",
        "editor.foreground": "{{colors.on_surface.default.hex}}",
        "editor.gutter.background": "{{colors.surface.default.hex}}",
        "editor.subheader.background": "{{colors.surface_container_low.default.hex}}",
        "editor.active_line.background": "{{colors.surface_container_low.default.hex}}",
        "editor.highlighted_line.background": "{{colors.surface_container.default.hex}}",
        "editor.line_number": "{{colors.outline.default.hex}}",
        "editor.active_line_number": "{{colors.primary.default.hex}}",
        "editor.invisible": "{{colors.outline_variant.default.hex}}",
        "editor.wrap_guide": "{{colors.surface_container_highest.default.hex}}",
        "editor.active_wrap_guide": "{{colors.outline_variant.default.hex}}",
        "editor.indent_guide": "{{colors.surface_container_highest.default.hex}}",
        "editor.indent_guide_active": "{{colors.outline.default.hex}}",
        "editor.document_highlight.read_background": "#{{colors.primary.default.hex_stripped}}1f",
        "editor.document_highlight.write_background": "#{{colors.primary.default.hex_stripped}}33",
        "editor.document_highlight.bracket_background": "#{{colors.primary.default.hex_stripped}}33",

        "terminal.background": "{{colors.surface.default.hex}}",
        "terminal.foreground": "{{colors.on_surface.default.hex}}",
        "terminal.bright_foreground": "{{colors.on_surface.default.hex}}",
        "terminal.dim_foreground": "{{colors.on_surface_variant.default.hex}}",
        "terminal.ansi.background": "{{colors.surface.default.hex}}",
        "terminal.ansi.black": "#45475A",
        "terminal.ansi.red": "#F38BA8",
        "terminal.ansi.green": "#A6E3A1",
        "terminal.ansi.yellow": "#F9E2AF",
        "terminal.ansi.blue": "#89B4FA",
        "terminal.ansi.magenta": "#F5C2E7",
        "terminal.ansi.cyan": "#94E2D5",
        "terminal.ansi.white": "#BAC2DE",
        "terminal.ansi.bright_black": "#585B70",
        "terminal.ansi.bright_red": "#F38BA8",
        "terminal.ansi.bright_green": "#A6E3A1",
        "terminal.ansi.bright_yellow": "#F9E2AF",
        "terminal.ansi.bright_blue": "#89B4FA",
        "terminal.ansi.bright_magenta": "#F5C2E7",
        "terminal.ansi.bright_cyan": "#94E2D5",
        "terminal.ansi.bright_white": "#A6ADC8",
        "terminal.ansi.dim_black": "#45475A99",
        "terminal.ansi.dim_red": "#F38BA899",
        "terminal.ansi.dim_green": "#A6E3A199",
        "terminal.ansi.dim_yellow": "#F9E2AF99",
        "terminal.ansi.dim_blue": "#89B4FA99",
        "terminal.ansi.dim_magenta": "#F5C2E799",
        "terminal.ansi.dim_cyan": "#94E2D599",
        "terminal.ansi.dim_white": "#BAC2DE99",

        "error": "{{colors.error.default.hex}}",
        "error.background": "#{{colors.error.default.hex_stripped}}1a",
        "error.border": "#{{colors.error.default.hex_stripped}}4d",
        "warning": "#F9E2AF",
        "warning.background": "#F9E2AF1a",
        "warning.border": "#F9E2AF4d",
        "info": "#89B4FA",
        "info.background": "#89B4FA1a",
        "info.border": "#89B4FA4d",
        "hint": "{{colors.tertiary.default.hex}}",
        "hint.background": "#{{colors.tertiary.default.hex_stripped}}1a",
        "hint.border": "#{{colors.tertiary.default.hex_stripped}}4d",
        "success": "#A6E3A1",
        "success.background": "#A6E3A11a",
        "success.border": "#A6E3A14d",
        "created": "#A6E3A1",
        "created.background": "#A6E3A11a",
        "created.border": "#A6E3A14d",
        "modified": "#F9E2AF",
        "modified.background": "#F9E2AF1a",
        "modified.border": "#F9E2AF4d",
        "deleted": "#F38BA8",
        "deleted.background": "#F38BA81a",
        "deleted.border": "#F38BA84d",
        "renamed": "#89B4FA",
        "renamed.background": "#89B4FA1a",
        "renamed.border": "#89B4FA4d",
        "conflict": "#F5C2E7",
        "conflict.background": "#F5C2E71a",
        "conflict.border": "#F5C2E74d",
        "ignored": "{{colors.outline.default.hex}}",
        "ignored.background": "#00000000",
        "ignored.border": "{{colors.outline_variant.default.hex}}",
        "hidden": "{{colors.outline.default.hex}}",
        "hidden.background": "#00000000",
        "hidden.border": "{{colors.outline_variant.default.hex}}",
        "predictive": "{{colors.outline.default.hex}}",
        "predictive.background": "#00000000",
        "predictive.border": "{{colors.outline_variant.default.hex}}",
        "unreachable": "{{colors.outline.default.hex}}",
        "unreachable.background": "#00000000",
        "unreachable.border": "{{colors.outline_variant.default.hex}}",

        "players": [
          {
            "cursor": "{{colors.primary.default.hex}}",
            "background": "{{colors.primary.default.hex}}",
            "selection": "#{{colors.primary.default.hex_stripped}}3d"
          }
        ],

        "accents": [
          "{{colors.primary.default.hex}}",
          "#F5C2E7",
          "#F9E2AF",
          "#A6E3A1",
          "#94E2D5",
          "{{colors.tertiary.default.hex}}"
        ],

        "syntax": {
          "comment": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "comment.doc": { "color": "{{colors.on_surface_variant.default.hex}}", "font_style": "italic" },
          "keyword": { "color": "{{colors.primary.default.hex}}" },
          "preproc": { "color": "{{colors.tertiary.default.hex}}" },
          "string": { "color": "#A6E3A1" },
          "string.escape": { "color": "#F5C2E7" },
          "string.regex": { "color": "#F5C2E7" },
          "string.special": { "color": "#F5C2E7" },
          "text.literal": { "color": "#A6E3A1" },
          "number": { "color": "#F5C2E7" },
          "boolean": { "color": "#F5C2E7" },
          "constant": { "color": "#F5C2E7" },
          "function": { "color": "#89B4FA" },
          "constructor": { "color": "#89B4FA" },
          "type": { "color": "#F9E2AF" },
          "enum": { "color": "#F9E2AF" },
          "variant": { "color": "#94E2D5" },
          "attribute": { "color": "#F9E2AF" },
          "property": { "color": "#94E2D5" },
          "label": { "color": "#94E2D5" },
          "operator": { "color": "#94E2D5" },
          "variable": { "color": "{{colors.on_surface.default.hex}}" },
          "variable.parameter": { "color": "#F38BA8" },
          "variable.special": { "color": "{{colors.tertiary.default.hex}}", "font_style": "italic" },
          "punctuation": { "color": "{{colors.on_surface_variant.default.hex}}" },
          "tag": { "color": "#89B4FA" },
          "title": { "color": "{{colors.primary.default.hex}}", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_text": { "color": "#89B4FA" },
          "link_uri": { "color": "#94E2D5" },
          "embedded": { "color": "{{colors.on_surface.default.hex}}" },
          "hint": { "color": "{{colors.tertiary.default.hex}}" },
          "predictive": { "color": "{{colors.outline.default.hex}}", "font_style": "italic" },
          "primary": { "color": "{{colors.on_surface.default.hex}}" }
        }
      }
    }
  ]
}
