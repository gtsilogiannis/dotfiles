// fastfetch for every terminal except Zed's (.zshrc). The logo is chosen per run:
// .zshrc passes a random image from ~/Pictures/fastfetch and the key color from matugen.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "top": 1,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    // Cut long values at the window edge: since fastfetch 2.65 they wrap and run under the image logo.
    "disableLinewrap": true,
    "separator": "  ",
    "key": {
      "width": 10
    },
    "color": {
      "keys": "blue",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    "separator",
    {
      "type": "os",
      "key": " os"
    },
    {
      "type": "kernel",
      "key": " kernel"
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime"
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs"
    },
    {
      "type": "shell",
      "key": " shell"
    },
    {
      "type": "wm",
      "key": " wm"
    },
    {
      "type": "terminal",
      "key": " term"
    },
    {
      "type": "cpu",
      "key": " cpu"
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu"
    },
    {
      "type": "memory",
      "key": "󰍛 mem"
    },
    {
      "type": "disk",
      "key": "󰋊 disk",
      "folders": "/"
    },
    {
      "type": "battery",
      "key": "󰁹 bat"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
