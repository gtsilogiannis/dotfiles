configuration {
    modi: "drun";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    display-drun: "Apps";
    drun-display-format: "{name}";
}

@theme "/dev/null"

* {
    bg: #11111b;
    fg: #cdd6f4;
    accent: #89b4fa;
    selected-bg: #313244;
    background-color: transparent;
    text-color: @fg;
    margin: 0;
    padding: 0;
}

window {
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 12px;
    width: 460px;
    padding: 16px;
}

inputbar {
    children: [ prompt, entry ];
    margin: 0 0 12px 0;
}

prompt {
    padding: 6px 12px;
    background-color: @accent;
    text-color: #11111b;
    border-radius: 6px;
    margin: 0 8px 0 0;
}

entry {
    padding: 6px;
    text-color: @fg;
    placeholder: "Search apps...";
    placeholder-color: #585b70;
}

listview {
    lines: 7;
    columns: 1;
    spacing: 4px;
}

element {
    padding: 8px 10px;
    border-radius: 6px;
}

element selected {
    background-color: @selected-bg;
    text-color: @accent;
}
