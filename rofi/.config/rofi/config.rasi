configuration {
    modi: "drun";
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    display-drun: "Apps";
    drun-display-format: "{name}";
}

@theme "/dev/null"
/* Colors come from matugen (colors.rasi, generated, not tracked). */
@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color: @on-surface;
    margin: 0;
    padding: 0;
}

window {
    background-color: @surface;
    border: 1px;
    border-color: @outline-variant;
    border-radius: 16px;
    width: 560px;
    padding: 18px;
}

inputbar {
    children: [ prompt, entry ];
    background-color: @surface-container;
    border-radius: 10px;
    padding: 6px;
    margin: 0 0 12px 0;
}

prompt {
    padding: 4px 10px;
    background-color: @primary;
    text-color: @on-primary;
    border-radius: 6px;
    margin: 0 8px 0 0;
}

entry {
    padding: 4px;
    placeholder: "Search apps...";
    placeholder-color: @on-surface-variant;
}

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
}

element {
    padding: 8px 10px;
    border-radius: 8px;
}

element selected {
    background-color: @primary-container;
    text-color: @on-primary-container;
}

element-icon {
    size: 22px;
    margin: 0 10px 0 0;
    background-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
