// Zed settings (JSONC: comments and trailing commas are allowed)
{
    // PRIVACY / ANTI-BLOAT
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "telemetry": {
        "diagnostics": false, // do not send crash reports
        "metrics": false, // do not send usage metrics
    },
    "auto_update": false, // updates are handled by pacman
    "show_edit_predictions": false, // edit predictions require a Zed account or provider
    "collaboration_panel": { "button": false }, // channels and calls are not used
    "title_bar": {
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_sign_in": false, // hide the Zed sign-in button (not needed for the agent panel)
        "show_branch_name": true,
        "show_project_items": true,
    },

    // THEME & FONTS
    "theme": { "mode": "dark", "dark": "gtsilos", "light": "One Light" }, // gtsilos: generated by matugen from the wallpaper
    "icon_theme": "Material Icon Theme",
    "auto_install_extensions": {
        "html": true,
        "material-icon-theme": true, // provides the icon theme above
        "lua": true, // Hyprland and Neovim configs (LuaLS)
        "toml": true, // matugen, starship, yazi, pyproject (taplo)
        "qml": true, // Quickshell (qmlls from Qt, path under "lsp")
        "git-firefly": true, // .gitignore, .gitconfig, commit messages
        "make": true, // Makefiles
        "codebook": true, // code-aware spell checker for comments and strings
    },
    "ui_font_family": "IBM Plex Sans",
    "ui_font_size": 16,
    "buffer_font_family": "Maple Mono NF", // same font as kitty
    "buffer_font_size": 15,
    "buffer_line_height": "standard", // 1.3, denser than "comfortable" (1.618)
    "buffer_font_features": { "calt": true }, // ligatures on (false to disable)
    "terminal": {
        "font_family": "Maple Mono NF",
        "font_size": 14,
        "line_height": "standard",
        "dock": "bottom",
        "cursor_shape": "bar", // same cursor as the editor
        "blinking": "off", // fewer redraws
        "copy_on_select": true, // selecting text copies it, as in kitty
        "max_scroll_history_lines": 10000,
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default",
            },
        }, // auto-activate Python venv
    },

    // EDITOR
    "relative_line_numbers": "enabled", // useful with Vim mode
    "cursor_blink": false, // fewer redraws
    "current_line_highlight": "gutter", // gutter only, not the whole line
    "show_whitespaces": "trailing", // show trailing whitespace only
    "colorize_brackets": true, // rainbow brackets
    "show_wrap_guides": true,
    "wrap_guides": [80], // ruler at column 80 (C style)
    "soft_wrap": "none",
    "scroll_beyond_last_line": "vertical_scroll_margin",
    "vertical_scroll_margin": 5,
    "minimap": { "show": "never" }, // minimap off (default)
    "sticky_scroll": { "enabled": true }, // keep the enclosing function or class header at the top
    "which_key": { "enabled": true, "delay_ms": 600 }, // list the possible next keys of a key sequence
    "use_smartcase_search": true, // case-sensitive only when the query has an uppercase letter
    "auto_signature_help": true, // show the parameters while typing a call
    "diagnostics": {
        "inline": { "enabled": true, "max_severity": "warning" }, // errors and warnings at the end of the line
    },
    "active_pane_modifiers": { "inactive_opacity": 0.85 }, // dim the unfocused pane in a split
    "indent_guides": { "enabled": true, "coloring": "indent_aware" },
    "inlay_hints": {
        "enabled": true, // inline types and parameter names
        "show_parameter_hints": true,
        "show_type_hints": true,
        "edit_debounce_ms": 700,
    },
    "format_on_save": "off", // on per language below, so no config file is reformatted by surprise
    "autosave": "on_focus_change", // save when leaving the file (runs format on save too)
    "tab_size": 4,
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_close_button": "hover",
        "show_diagnostics": "errors", // mark tabs with errors
    },
    "toolbar": { "breadcrumbs": true, "quick_actions": false },
    "git": {
        "inline_blame": { "enabled": false }, // off: less noise and fewer git calls
    },

    // PANELS
    "project_panel": {
        "dock": "left",
        "default_width": 240,
        "git_status": true,
        "auto_fold_dirs": true,
        "entry_spacing": "standard", // denser list
        "diagnostic_badges": true, // error and warning counts next to files
    },
    "file_finder": { "modal_max_width": "medium" }, // room for long paths
    "outline_panel": { "dock": "left" },
    "git_panel": { "dock": "left" },
    "agent": { "dock": "right" }, // agent panel on the right
    "debugger": { "dock": "bottom" },

    // VIM (OPTIONAL)
    "vim_mode": false, // set to true for Vim keybindings

    // LANGUAGES
    "languages": {
        "C": {
            "tab_size": 4,
            "format_on_save": "on", // format through clangd (clang-format)
        },
        "Python": {
            "tab_size": 4,
            "format_on_save": "on",
            "code_actions_on_format": { "source.organizeImports.ruff": true }, // sort imports
            "formatter": { "language_server": { "name": "ruff" } }, // format with Ruff
        },
        "JSON": { "tab_size": 2 },
        "JSONC": { "tab_size": 2 },
        "Markdown": { "soft_wrap": "editor_width" }, // wrap long lines of notes
    },
    "lsp": {
        "clangd": {
            "binary": {
                "path": "/usr/bin/clangd",
                "arguments": ["--background-index", "--clang-tidy"],
            }, // system clangd (pacman -S clang)
        },
        "qmlls": {
            "binary": { "path": "/usr/lib/qt6/bin/qmlls" }, // from qt6-declarative, not in PATH
        },
    },
}
