// Zed settings (JSONC)
{
    // Privacy and clutter
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
    "auto_update": false, // pacman updates it
    "show_edit_predictions": false, // needs a Zed account or provider
    "collaboration_panel": { "button": false },
    "title_bar": {
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_sign_in": false, // the agent panel works without it
        "show_branch_name": true,
        "show_project_items": true,
    },

    // Theme and fonts
    "theme": { "mode": "dark", "dark": "gtsilos", "light": "One Light" }, // generated by matugen
    "icon_theme": "Material Icon Theme",
    "auto_install_extensions": {
        "html": true,
        "material-icon-theme": true,
        "lua": true, // LuaLS
        "toml": true, // taplo
        "qml": true, // qmlls path under lsp
        "git-firefly": true, // .gitignore, .gitconfig, commit messages
        "make": true,
        "codebook": true, // spell checker for comments and strings
    },
    "ui_font_family": "IBM Plex Sans",
    "ui_font_size": 16,
    "buffer_font_family": "Maple Mono NF", // same font as kitty
    "buffer_font_size": 15,
    "buffer_line_height": "standard", // 1.3
    "buffer_font_features": { "calt": true }, // ligatures
    "terminal": {
        "font_family": "Maple Mono NF",
        "font_size": 14,
        "line_height": "standard",
        "dock": "bottom",
        "cursor_shape": "bar",
        "blinking": "off",
        "copy_on_select": true, // as in kitty
        "max_scroll_history_lines": 10000,
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default",
            },
        },
    },

    // Editor
    "relative_line_numbers": "enabled",
    "cursor_blink": false,
    "current_line_highlight": "gutter",
    "show_whitespaces": "trailing",
    "colorize_brackets": true,
    "show_wrap_guides": true,
    "wrap_guides": [80],
    "soft_wrap": "none",
    "scroll_beyond_last_line": "vertical_scroll_margin",
    "vertical_scroll_margin": 5,
    "minimap": { "show": "never" },
    "sticky_scroll": { "enabled": true },
    "which_key": { "enabled": true, "delay_ms": 600 },
    "use_smartcase_search": true,
    "auto_signature_help": true,
    "diagnostics": {
        "inline": { "enabled": true, "max_severity": "warning" },
    },
    "active_pane_modifiers": { "inactive_opacity": 0.85 },
    "indent_guides": { "enabled": true, "coloring": "indent_aware" },
    "inlay_hints": {
        "enabled": true,
        "show_parameter_hints": true,
        "show_type_hints": true,
        "edit_debounce_ms": 700,
    },
    "format_on_save": "off", // on per language below, so configs are never reformatted
    "autosave": "on_focus_change", // also formats, where on
    "tab_size": 4,
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_close_button": "hover",
        "show_diagnostics": "errors",
    },
    "toolbar": { "breadcrumbs": true, "quick_actions": false },
    "git": {
        "inline_blame": { "enabled": false }, // less noise, fewer git calls
    },

    // Panels
    "project_panel": {
        "dock": "left",
        "default_width": 240,
        "git_status": true,
        "auto_fold_dirs": true,
        "entry_spacing": "standard",
        "diagnostic_badges": true,
    },
    "file_finder": { "modal_max_width": "medium" },
    "outline_panel": { "dock": "left" },
    "git_panel": { "dock": "left" },
    "agent": { "dock": "right" },
    "debugger": { "dock": "bottom" },

    "vim_mode": false,

    // Languages
    "languages": {
        "C": {
            "tab_size": 4,
            "format_on_save": "on", // clang-format through clangd
        },
        "Python": {
            "tab_size": 4,
            "format_on_save": "on",
            "code_actions_on_format": { "source.organizeImports.ruff": true },
            "formatter": { "language_server": { "name": "ruff" } },
        },
        "JSON": { "tab_size": 2 },
        "JSONC": { "tab_size": 2 },
        "Markdown": { "soft_wrap": "editor_width" },
    },
    "lsp": {
        "clangd": {
            "binary": {
                "path": "/usr/bin/clangd",
                "arguments": ["--background-index", "--clang-tidy"],
            },
        },
        "qmlls": {
            "binary": { "path": "/usr/lib/qt6/bin/qmlls" }, // qt6-declarative, not in PATH
        },
    },
}
