// Zed settings (JSONC: comments and trailing commas are allowed)
{
    // PRIVACY / ANTI-BLOAT
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "telemetry": {
        "diagnostics": false, // do not send crash reports
        "metrics": false, // do not send usage metrics
    },
    "auto_update": false, // updates are handled by pacman
    "show_edit_predictions": false, // edit predictions require a Zed account or provider
    "collaboration_panel": { "button": false }, // channels and calls are not used
    "title_bar": {
        "show_onboarding_banner": false,
        "show_user_picture": false,
        "show_sign_in": false, // hide the Zed sign-in button (not needed for the agent panel)
        "show_branch_name": true,
        "show_project_items": true,
    },

    // THEME & FONTS
    "theme": { "mode": "dark", "dark": "One Dark", "light": "One Light" },
    "icon_theme": "Zed (Default)",
    "ui_font_family": ".ZedSans", // bundled UI font
    "ui_font_size": 16,
    "buffer_font_family": "JetBrainsMono Nerd Font", // same font as kitty
    "buffer_font_size": 15,
    "buffer_line_height": "standard", // 1.3, denser than "comfortable" (1.618)
    "buffer_font_features": { "calt": true }, // ligatures on (false to disable)
    "terminal": {
        "font_family": "JetBrainsMono Nerd Font",
        "font_size": 14,
        "line_height": "standard",
        "dock": "bottom",
        "max_scroll_history_lines": 10000,
        "detect_venv": {
            "on": {
                "directories": [".venv", "venv"],
                "activate_script": "default",
            },
        }, // auto-activate Python venv
    },

    // EDITOR
    "relative_line_numbers": "enabled", // useful with Vim mode
    "cursor_blink": false, // fewer redraws
    "current_line_highlight": "gutter", // gutter only, not the whole line
    "show_whitespaces": "trailing", // show trailing whitespace only
    "colorize_brackets": true, // rainbow brackets
    "show_wrap_guides": true,
    "wrap_guides": [80], // ruler at column 80 (C style)
    "soft_wrap": "none",
    "scroll_beyond_last_line": "vertical_scroll_margin",
    "vertical_scroll_margin": 5,
    "minimap": { "show": "never" }, // minimap off (default)
    "indent_guides": { "enabled": true, "coloring": "indent_aware" },
    "inlay_hints": {
        "enabled": true, // inline types and parameter names
        "show_parameter_hints": true,
        "show_type_hints": true,
        "edit_debounce_ms": 700,
    },
    "format_on_save": "on",
    "tab_size": 4,
    "tabs": {
        "file_icons": true,
        "git_status": true,
        "show_close_button": "hover",
    },
    "toolbar": { "breadcrumbs": true, "quick_actions": false },
    "git": {
        "inline_blame": { "enabled": false }, // off: less noise and fewer git calls
    },

    // PANELS
    "project_panel": {
        "dock": "left",
        "default_width": 240,
        "git_status": true,
        "auto_fold_dirs": true,
    },
    "outline_panel": { "dock": "left" },
    "git_panel": { "dock": "left" },
    "agent": { "dock": "right" }, // agent panel on the right
    "debugger": { "dock": "bottom" },

    // VIM (OPTIONAL)
    "vim_mode": false, // set to true for Vim keybindings

    // LANGUAGES
    "languages": {
        "C": {
            "tab_size": 4,
            "format_on_save": "on", // format through clangd (clang-format)
        },
        "Python": {
            "tab_size": 4,
            "format_on_save": "on",
            "code_actions_on_format": { "source.organizeImports.ruff": true }, // sort imports
            "formatter": { "language_server": { "name": "ruff" } }, // format with Ruff
        },
    },
    "lsp": {
        "clangd": {
            "binary": {
                "path": "/usr/bin/clangd",
                "arguments": ["--background-index", "--clang-tidy"],
            }, // system clangd (pacman -S clang)
        },
    },
}
