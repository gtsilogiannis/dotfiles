#!/usr/bin/env bash
# Sets the background of the SDDM login screen (sddm-astronaut-theme). Runs as
# root, through pkexec from ~/.config/quickshell/scripts/set-login-wallpaper.sh.
#
#   sddm-set-background < <image>    use the PNG or JPEG read from stdin
#   sddm-set-background --reset      back to the background of the theme
#
# The image comes on stdin, so root never opens a path chosen by the caller.
# It is copied to /usr/local/share/sddm/, which the sddm user can read (it
# cannot read home directories), and the theme is pointed at it with
# <ConfigFile>.user next to the theme config: SDDM reads that file after the
# config and its keys win. No file of the package changes, so an update of the
# theme keeps the override. Installed with sudo install, not Stow.
set -euo pipefail

theme=/usr/share/sddm/themes/sddm-astronaut-theme
dest=/usr/local/share/sddm
max=$((50 * 1024 * 1024))

die() {
    printf 'sddm-set-background: %s\n' "$1" >&2
    exit 1
}

[[ $EUID -eq 0 ]] || die "run as root (pkexec or sudo)"
[[ -f "$theme/metadata.desktop" ]] || die "$theme not found"

config=$(sed -n 's/^ConfigFile=//p' "$theme/metadata.desktop" | head -n 1)
[[ -n "$config" && "$config" != *..* ]] || die "no ConfigFile in metadata.desktop"
user="$theme/$config.user"

if [[ "${1:-}" == --reset ]]; then
    rm -f "$user" "$dest"/background.*
    exit 0
fi
[[ $# -eq 0 ]] || die "usage: sddm-set-background < image | --reset"
[[ ! -t 0 ]] || die "no image on stdin"

umask 022
mkdir -p "$dest"
tmp=$(mktemp "$dest/.incoming.XXXXXX")
trap 'rm -f "$tmp"' EXIT

head -c $((max + 1)) > "$tmp"
size=$(stat -c %s "$tmp")
(( size > 0 )) || die "empty input"
(( size <= max )) || die "image larger than 50 MiB"

case "$(file -b --mime-type "$tmp")" in
    image/png) ext=png ;;
    image/jpeg) ext=jpg ;;
    *) die "not a PNG or JPEG image" ;;
esac

chmod 644 "$tmp"
mv -f "$tmp" "$dest/background.$ext"
trap - EXIT
find "$dest" -maxdepth 1 -name 'background.*' ! -name "background.$ext" -delete

printf '[General]\nBackground="%s"\n' "$dest/background.$ext" > "$user.tmp"
chmod 644 "$user.tmp"
mv -f "$user.tmp" "$user"
