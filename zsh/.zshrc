# Interactive zsh. The load order matters: history, theme colors, completion,
# fzf, fzf-tab, zoxide, autosuggestions, prompt and syntax highlighting last.

setopt interactive_comments

# History: one file shared by every terminal, no duplicates, and a command
# typed with a leading space is kept out of it.
HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/zsh/history"
HISTSIZE=50000
SAVEHIST=50000
[[ -d ${HISTFILE:h} ]] || mkdir -p ${HISTFILE:h}
setopt extended_history share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks hist_verify

# Theme colors generated by matugen (fzf, autosuggestions, fastfetch).
[[ -r ~/.config/zsh/colors.zsh ]] && source ~/.config/zsh/colors.zsh

# Fastfetch every session.
[[ -z "$ZED_TERM" ]] && fastfetch

# Emacs keys, plus Ctrl+arrows by word and Home / End / Delete as kitty sends them.
bindkey -e
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[1;3C' forward-word
bindkey '^[[1;3D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# Completion. zsh-completions installs its definitions in a directory that is already in fpath.
eval "$(dircolors -b)"
autoload -Uz compinit
zcompdump="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-$ZSH_VERSION"
[[ -d ${zcompdump:h} ]] || mkdir -p ${zcompdump:h}
compinit -d "$zcompdump"
# Case-insensitive, then partial matches around . _ - and anywhere in the word.
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/compcache"
# Settings fzf-tab expects: group headers, no zsh menu, git branches in their own order.
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':completion:*:git-checkout:*' sort false

# fzf: Ctrl+R history, Ctrl+T files, Alt+C directories. fd lists files and respects .gitignore.
export FZF_DEFAULT_OPTS="--height=50% --layout=reverse --border=rounded --info=inline-right ${FZF_COLORS:-}"
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --icons=always --color=always {}'"
source <(fzf --zsh)

# fzf-tab: Tab opens an fzf menu. Loaded after fzf so that it owns the Tab key.
source /usr/share/zsh/plugins/fzf-tab-git/fzf-tab.plugin.zsh
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group '<' '>'
# Preview: directory listing for directories, the first lines of a file otherwise.
zstyle ':fzf-tab:complete:(cd|z|zi|l|ll|la|lt|eza|ls|bat|cat|micro|v|nvim|rm|cp|mv):*' fzf-preview \
    '[[ -d $realpath ]] && eza -1 --icons=always --color=always $realpath || bat --color=always --style=numbers --line-range=:100 $realpath 2>/dev/null'
zstyle ':fzf-tab:complete:systemctl-*:*' fzf-preview 'SYSTEMD_COLORS=1 systemctl status $word'

# zoxide: z <part of a path> jumps to the most used match, zi picks one with fzf.
eval "$(zoxide init zsh)"

# Suggestions from history first, then from completion; accept with Right or End.
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=200
source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# Starship Prompt.
eval "$(starship init zsh)"

# Aliases. ls and cat stay GNU (plain output to paste); eza and bat get their own names.
alias c="clear"
alias ls="ls --color=auto"
alias grep="grep --color=auto"
alias l="eza --group-directories-first --icons=auto"
alias ll="eza -l --git --group-directories-first --icons=auto --time-style=long-iso"
alias la="ll -a"
alias lt="eza --tree --level=2 --group-directories-first --icons=auto"
alias b="bat"
alias v="micro"
alias sv="sudo micro"

# Auto-refresh Waybar package counter after update.
alias up='yay && qs ipc call stats refreshUpdates'


# Full system cleanup.
alias sysclean='sudo pacman -Rns $(pacman -Qtdq) 2>/dev/null; sudo paccache -rk1; sudo paccache -ruk0; yay -Sc --aur --noconfirm; sudo journalctl --vacuum-size=50M; rm -rf ~/.cache/thumbnails/* ~/.local/share/Trash/*; echo "System Cleaned Successfully"'


# FPL RUNNER
alias fpl='cd ~/FPL && source venv/bin/activate'

# Show the active venv in the right prompt (RPROMPT)
setopt prompt_subst
show_virtual_env() {
    if [[ -n "$VIRTUAL_ENV" ]]; then
        echo "(%F{cyan}$(basename "$VIRTUAL_ENV")%f) "
    fi
}
RPROMPT='$(show_virtual_env)'
export PATH="$HOME/.local/bin:$PATH"
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
ssh-add -l >/dev/null 2>&1; [[ $? -eq 1 ]] && ssh-add ~/.ssh/id_ed25519

# Syntax highlighting wraps every widget defined before it, so it is sourced last.
source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
